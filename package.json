    "@electron-toolkit/utils": "4.0.0",
    "@fairspec/library": "0.12.1",
    "@fairspec/metadata": "0.12.1",
    "@lingui/babel-plugin-lingui-macro": "6.1.0",
    "@lingui/cli": "6.1.0",
    "@lingui/core": "6.1.0",
    "@lingui/detect-locale": "6.1.0",
    "@lingui/format-po": "6.1.0",
    "@lingui/macro": "5.9.5",
    "@lingui/react": "6.1.0",
    "@lingui/vite-plugin": "6.1.0",
    "@orpc/client": "1.14.3",
    "@orpc/server": "1.14.3",
    "@orpc/tanstack-query": "1.14.3",
    "@orpc/zod": "1.14.3",
    "@rolldown/plugin-babel": "0.2.3",
    "@semantic-release/exec": "7.1.0",
