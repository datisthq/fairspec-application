{
  "name": "fairspec",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Fairspec Application is a visual tool for managing and validating tabular and structured data",
  "homepage": "https://fairspec.org",
  "license": "MIT",
  "author": "Evgeny Karev",
  "repository": "https://github.com/datisthq/fairspec-application",
  "type": "module",
  "main": "build/main/main.js",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "electron-vite build",
    "compile": "electron-builder --publish never",
    "coverage": "sensible-browser coverage/index.html",
    "deps": "ncu -u",
    "extract": "lingui extract",
    "format": "vp fmt",
    "leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "lint": "vp fmt --check && vp lint",
    "prepare": "lefthook install",
    "preview": "electron-vite preview",
    "scan": "pnpm leaks && pnpm vulns",
    "start": "electron-vite dev",
    "test": "pnpm lint && pnpm type && pnpm unit",
    "type": "tsgo --noEmit",
    "ui": "shadcn",
    "unit": "vp test",
    "vers": "pnpm version --no-git-tag-version --no-git-checks",
    "vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --metrics=off"
  },
  "dependencies": {
    "@loglayer/transport-electron-log": "3.0.3",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "loglayer": "6.9.1",
    "nodejs-polars": "0.23.5"
  },
