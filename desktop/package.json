{
  "name": "@fairspec/desktop",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Fairspec Application is a visual tool for managing and validating tabular and structured data",
  "homepage": "https://application.fairspec.org",
  "license": "MIT",
  "author": "Evgeny Karev",
  "repository": "https://github.com/fairspec/fairspec-application",
  "type": "module",
  "main": "build/main/main.js",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "node @build.ts",
    "compile": "electron-builder --publish never",
    "start": "wait-on tcp:8000 && electron-vite dev",
    "type": "tsgo --noEmit"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@fairspec/engine": "workspace:*",
    "@fairspec/website": "workspace:*",
    "@loglayer/transport-electron-log": "3.0.3",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "loglayer": "6.9.1",
    "nodejs-polars": "0.23.5"
  },
  "devDependencies": {
    "electron": "42.2.0",
    "electron-builder": "26.8.1",
    "electron-updater": "6.8.3",
    "electron-vite": "5.0.0",
    "wait-on": "9.0.10"
  }
}
